generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Title {
  hashtag       Int       @id
  titleName     String    @db.VarChar(255) @map("title_name")
  alterName     String?   @db.VarChar(255) @map("alter_name")
  imageLink     String    @db.VarChar(255) @map("image_link")
  pages         Int
  uploadedAt    DateTime  @db.Date @map("uploaded_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  readCount     Int       @default(0) @map("read_count")
  lastReadAt    DateTime? @map("last_read_at")
  // Mean global frequency of this title's tags (a tag's "value" = how many
  // titles carry it). Maintained by DB triggers on titlestotags — see
  // migration 3_avg_tag_value. Null when the title has no tags.
  avgTagValue   Float?    @map("avg_tag_value")

  artists    TitleArtist[]
  groups     TitleGroup[]
  characters TitleCharacter[]
  parodies   TitleParody[]
  tags       TitleTag[]
  readLogs   ReadLog[]

  @@index([createdAt(sort: Desc)])
  @@index([lastReadAt(sort: Desc)])
  @@index([readCount(sort: Desc)])
  @@index([uploadedAt(sort: Desc)])
  @@index([pages])
  @@index([avgTagValue])
  @@map("titles")
}

model Artist {
  idArtist   Int           @id @default(autoincrement()) @map("id_artist")
  artistName String        @unique @db.VarChar(255) @map("artist_name")
  artistLink String        @unique @db.VarChar(255) @map("artist_link")
  totalWorks Int?          @map("total_works")

  titles TitleArtist[]

  @@map("artists")
}

model Group {
  idGroup    Int          @id @default(autoincrement()) @map("id_group")
  groupName  String       @unique @db.VarChar(255) @map("group_name")
  groupLink  String       @unique @db.VarChar(255) @map("group_link")
  totalWorks Int?         @map("total_works")

  titles TitleGroup[]

  @@map("groups")
}

model Character {
  idCharacter   Int              @id @default(autoincrement()) @map("id_character")
  characterName String           @unique @db.VarChar(255) @map("character_name")
  characterLink String           @unique @db.VarChar(255) @map("character_link")
  totalWorks    Int?             @map("total_works")

  titles TitleCharacter[]

  @@map("characters")
}

model Parody {
  idParodie   Int              @id @default(autoincrement()) @map("id_parodie")
  parodieName String           @unique @db.VarChar(255) @map("parodie_name")
  parodieLink String           @unique @db.VarChar(255) @map("parodie_link")
  totalWorks  Int?             @map("total_works")

  titles TitleParody[]

  @@map("parodies")
}

model Tag {
  idTag      Int        @id @default(autoincrement()) @map("id_tag")
  tagName    String     @unique @db.VarChar(255) @map("tag_name")
  tagLink    String     @unique @db.VarChar(255) @map("tag_link")
  totalWorks Int?       @map("total_works")
  // Number of titles carrying this tag (this tag's "value"). Maintained by DB
  // triggers on titlestotags — see migration 3_avg_tag_value.
  titleCount Int        @default(0) @map("title_count")

  titles TitleTag[]

  @@map("tags")
}

model TitleArtist {
  hashtag  Int
  idArtist Int    @map("id_artist")
  title    Title  @relation(fields: [hashtag], references: [hashtag], onDelete: Cascade, onUpdate: NoAction)
  artist   Artist @relation(fields: [idArtist], references: [idArtist], onDelete: Cascade, onUpdate: NoAction)

  @@id([hashtag, idArtist])
  @@index([idArtist])
  @@map("titlestoartists")
}

model TitleGroup {
  hashtag Int
  idGroup Int   @map("id_group")
  title   Title @relation(fields: [hashtag], references: [hashtag], onDelete: Cascade, onUpdate: NoAction)
  group   Group @relation(fields: [idGroup], references: [idGroup], onDelete: Cascade, onUpdate: NoAction)

  @@id([hashtag, idGroup])
  @@index([idGroup])
  @@map("titlestogroups")
}

model TitleCharacter {
  hashtag     Int
  idCharacter Int       @map("id_character")
  title       Title     @relation(fields: [hashtag], references: [hashtag], onDelete: Cascade, onUpdate: NoAction)
  character   Character @relation(fields: [idCharacter], references: [idCharacter], onDelete: Cascade, onUpdate: NoAction)

  @@id([hashtag, idCharacter])
  @@index([idCharacter])
  @@map("titlestocharacters")
}

model TitleParody {
  hashtag   Int
  idParodie Int    @map("id_parodie")
  title     Title  @relation(fields: [hashtag], references: [hashtag], onDelete: Cascade, onUpdate: NoAction)
  parody    Parody @relation(fields: [idParodie], references: [idParodie], onDelete: Cascade, onUpdate: NoAction)

  @@id([hashtag, idParodie])
  @@index([idParodie])
  @@map("titlestoparodies")
}

model TitleTag {
  hashtag Int
  idTag   Int   @map("id_tag")
  title   Title @relation(fields: [hashtag], references: [hashtag], onDelete: Cascade, onUpdate: NoAction)
  tag     Tag   @relation(fields: [idTag], references: [idTag], onDelete: Cascade, onUpdate: NoAction)

  @@id([hashtag, idTag])
  @@index([idTag])
  @@map("titlestotags")
}

model ReadLog {
  id      Int      @id @default(autoincrement())
  hashtag Int
  readAt  DateTime @default(now()) @map("read_at")
  title   Title    @relation(fields: [hashtag], references: [hashtag], onDelete: Cascade)

  @@index([readAt(sort: Desc)])
  @@index([hashtag])
  @@map("read_logs")
}
